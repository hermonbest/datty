# Server Configuration
PORT=3000
NODE_ENV=production

# Cloudinary Server Credentials (Required for signed uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firebase Admin Credentials (Choose Option A or Option B)
# Option A: Single-line JSON string of service account key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Option B: Individual environment variables
FIREBASE_PROJECT_ID=datty-40e3b
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@datty-40e3b.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Limits & Concurrency
MAX_DURATION_SECONDS=300
MAX_FILE_SIZE_MB=25
MAX_CONCURRENT_JOBS=4
